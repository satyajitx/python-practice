
import sqlite3
from datetime import date

import pandas as pd
import streamlit as st

DB_NAME = "jobs.db"

st.set_page_config(
    page_title="JobTrack | Career Dashboard",
    page_icon="💼",
    layout="wide"
)


# ---------- DATABASE ----------
def connect_db():
    return sqlite3.connect(DB_NAME)


def initialize_db():
    with connect_db() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS applications (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                company TEXT NOT NULL,
                role TEXT NOT NULL,
                location TEXT,
                job_link TEXT,
                applied_date TEXT NOT NULL,
                status TEXT NOT NULL,
                interview_date TEXT,
                notes TEXT
            )
        """)


def add_application(company, role, location, link,
                    applied_date, status, interview_date, notes):
    with connect_db() as conn:
        conn.execute("""
            INSERT INTO applications
            (company, role, location, job_link, applied_date,
             status, interview_date, notes)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            company, role, location, link, str(applied_date),
            status,
            str(interview_date) if interview_date else None,
            notes
        ))


def load_applications():
    with connect_db() as conn:
        return pd.read_sql_query(
            "SELECT * FROM applications ORDER BY applied_date DESC",
            conn
        )


def update_status(job_id, new_status):
    with connect_db() as conn:
        conn.execute(
            "UPDATE applications SET status = ? WHERE id = ?",
            (new_status, job_id)
        )


def delete_application(job_id):
    with connect_db() as conn:
        conn.execute(
            "DELETE FROM applications WHERE id = ?",
            (job_id,)
        )


initialize_db()


# ---------- DESIGN ----------
st.markdown("""
<style>
.stApp {
    background: linear-gradient(135deg, #0b1220, #14213d);
    color: #f8fafc;
}
.block-container {
    max-width: 1200px;
    padding-top: 2rem;
}
[data-testid="stMetric"] {
    background: #172842;
    border: 1px solid #2b4161;
    padding: 18px;
    border-radius: 16px;
}
</style>
""", unsafe_allow_html=True)

st.title("💼 JobTrack")
st.caption("Your career journey, organized in one place.")

jobs = load_applications()

# ---------- ANALYTICS ----------
total = len(jobs)
interviews = int((jobs["status"] == "Interview").sum()) if total else 0
offers = int((jobs["status"] == "Offer").sum()) if total else 0
pending = int((jobs["status"] == "Applied").sum()) if total else 0

c1, c2, c3, c4 = st.columns(4)
c1.metric("Total Applications", total)
c2.metric("Interviews", interviews)
c3.metric("Offers", offers)
c4.metric("Awaiting Response", pending)

st.divider()

# ---------- ADD APPLICATION ----------
st.subheader("➕ Add a Job Application")

with st.form("add_job", clear_on_submit=True):
    company = st.text_input("Company name")
    role = st.text_input("Job title")
    location = st.text_input("Location")
    link = st.text_input("Job posting URL")
    applied_date = st.date_input("Application date", value=date.today())

    status = st.selectbox(
        "Application status",
        ["Applied", "Interview", "Offer", "Rejected", "Withdrawn"]
    )

    has_interview = st.checkbox("Interview scheduled?")
    interview_date = None

    if has_interview:
        interview_date = st.date_input(
            "Interview date",
            value=date.today(),
            key="interview_date"
        )

    notes = st.text_area("Notes")

    submitted = st.form_submit_button(
        "Save Application",
        use_container_width=True
    )

    if submitted:
        if not company.strip() or not role.strip():
            st.error("Company and job title are required.")
        else:
            add_application(
                company.strip(),
                role.strip(),
                location.strip(),
                link.strip(),
                applied_date,
                status,
                interview_date,
                notes.strip()
            )
            st.success("Application saved successfully!")
            st.rerun()


# ---------- APPLICATION TABLE ----------
st.subheader("📋 Your Applications")

jobs = load_applications()

if jobs.empty:
    st.info("No applications yet. Add your first job above.")
else:
    filter_status = st.selectbox(
        "Filter by status",
        ["All"] + sorted(jobs["status"].unique().tolist())
    )

    filtered = jobs.copy()

    if filter_status != "All":
        filtered = filtered[filtered["status"] == filter_status]

    st.dataframe(
        filtered,
        use_container_width=True,
        hide_index=True,
        column_config={
            "job_link": st.column_config.LinkColumn("Job Posting"),
            "id": None
        }
    )

    st.download_button(
        "⬇️ Export Applications to CSV",
        data=filtered.to_csv(index=False).encode("utf-8"),
        file_name="job_applications.csv",
        mime="text/csv"
    )

    st.divider()
    st.subheader("✏️ Manage an Application")

    selected_id = st.selectbox(
        "Select application ID",
        jobs["id"].tolist()
    )

    selected_job = jobs[jobs["id"] == selected_id].iloc[0]

    new_status = st.selectbox(
        "Update status",
        ["Applied", "Interview", "Offer", "Rejected", "Withdrawn"],
        index=[
            "Applied", "Interview", "Offer", "Rejected", "Withdrawn"
        ].index(selected_job["status"])
    )

    col1, col2 = st.columns(2)

    with col1:
        if st.button("Update Status", use_container_width=True):
            update_status(selected_id, new_status)
            st.success("Status updated.")
            st.rerun()

    with col2:
        confirm_delete = st.checkbox(
            "Confirm deletion",
            key="confirm_delete"
        )

        if st.button(
            "Delete Application",
            disabled=not confirm_delete,
            use_container_width=True
        ):
            delete_application(selected_id)
            st.success("Application deleted.")
            st.rerun()


# ---------- CHART ----------
if not jobs.empty:
    st.subheader("📈 Application Status Breakdown")

    chart = jobs["status"].value_counts()
    st.bar_chart(chart)

    upcoming = jobs[
        (jobs["interview_date"].notna()) &
        (jobs["interview_date"] >= date.today().isoformat()) &
        (jobs["status"] == "Interview")
    ].sort_values("interview_date")

    st.subheader("🗓️ Upcoming Interviews")

    if upcoming.empty:
        st.caption("No upcoming interviews recorded.")
    else:
        st.dataframe(
            upcoming[["company", "role", "interview_date"]],
            use_container_width=True,
            hide_index=True
        )

st.caption("JobTrack · Built with Python, SQLite and Streamlit")
